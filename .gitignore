# Secrets — never commit these
.env
.env.local
credentials.json
token.json

# Per-client provisioning env. One file per paying client, each holding that
# client's live database URL, Twilio token, and provider credentials.
# clients/template.env is the only one that is tracked.
clients/*.env
!clients/template.env

# Runtime state
state.json
agent.log
*.log
.superpowers/
.playwright-mcp/
.tmp/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Next.js
node_modules/
.next/
out/

# Local bulk data caches (county CAD rolls, etc.)
data/tcad/*.zip
data/tcad/layout/
tsconfig.tsbuildinfo

# Local docs dump (553MB, not part of build)
claude-md/

# Playwright CLI artifacts
.playwright-cli/
.DS_Store
public/uploads/
.vercel
graphify-out/
